# Supabase（プロジェクト設定 > API から取得）
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# サーバー側のみ。管理操作・署名URL発行に使用。絶対に公開しないこと。
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# サイトURL（マジックリンクのリダイレクト先）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 新規投稿のSlack通知（任意・S6で使用）
SLACK_WEBHOOK_URL=

# Shopify購入証明連携 Phase 0（orders/create Webhook のHMAC検証用）
SHOPIFY_WEBHOOK_SECRET=

# Shopify商品カタログPull同期（/admin/products の同期ボタン・Admin API read_products スコープ）
SHOPIFY_ADMIN_SHOP_DOMAIN=xxxx.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_...
